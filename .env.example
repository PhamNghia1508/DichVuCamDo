# --- Qloo (hackathon key arrives by email) ---------------------------------
# Leave empty to run in MOCK mode with hand-written sample data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- LLM (any OpenAI-compatible chat-completions endpoint with tool calling) -
# Leave empty to use the built-in deterministic planner (same tools, no LLM).
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
# Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                     LLM_MODEL=gemini-2.5-flash
# Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Force mock mode even when QLOO_API_KEY is set (handy for demos/tests)
TASTECIRCLE_FORCE_MOCK=
